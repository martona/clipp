<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest template for the packaged (full-trust Win32) build of Clipp.
  @TOKENS@ are substituted by scripts/package_windows_msix.ps1.

  Two Applications, because Windows bakes the GUI-vs-console subsystem into the PE
  header at link time and a single PE can't be both:
    - clippmain.exe: the GUI tray app (/SUBSYSTEM:WINDOWS). The visible Start entry.
    - clipp.exe: the console twin (/SUBSYSTEM:CONSOLE; this is the former
                        clipp.com renamed, since MSIX requires Executable to end in
                        .exe). Hidden from Start, exposed on PATH as `clipp` via an
                        App Execution Alias. This is what gives real pipe/stdin/exit-
                        code behavior from the command line; the GUI exe cannot.
  The packaging script does the rename: build clipp.exe -> clippmain.exe, build
  clipp.com -> clipp.exe.

  Other notes:
    - EntryPoint="Windows.FullTrustApplication" + rescap:runFullTrust: both run
      UNSANDBOXED (not AppContainer), so networking/clipboard/DPAPI work as unpackaged.
    - Registry is copy-on-write, though: the app READS the real HKCU (merged) but its
      WRITES land in a per-package overlay invisible to the rest of the system. So the
      app's HKCU\...\Run autostart never reaches the logon scan (which reads the real
      hive). windows.startupTask below is the autostart that actually fires; the app
      should enable/disable it via the Windows.ApplicationModel.StartupTask WinRT API
      when packaged (AutoStart.cpp's Run-key path is a no-op here).
    - rescap:uiAccess (pattern from ../WM_NIGHT): keeps uiAccess working in the
      package, so the popup's synthetic Ctrl+V reaches ELEVATED windows. The staged
      clippmain.exe carries uiAccess=true in its embedded manifest (build_windows.ps1
      flips it in place on Release builds); WindowsApps satisfies the secure-path half
      of the uiAccess policy, the Trusted Signing signature the other. The PAIRING is
      mandatory — a packaged uiAccess=true exe without this capability fails
      activation — so the packaging script asserts the stamp before staging.
      RESTRICTED capability: sideload/winget of a signed package is fine; a Store
      submission needs Partner Center approval (justification: clipboard tool pasting
      into elevated windows at the user's explicit keystroke) — if refused, build with
      -SkipUiAccessStamp AND drop this capability together. Upgrade over a
      pre-uiAccess install: VERIFIED flawless (2026-07-24). Known taxes of the
      capability: the package install itself requires elevation, and App Installer's
      post-install "Launch" button cannot start the app (its own sandboxed activation
      cannot broker a uiAccess process launch; Start menu, hotkey, and the startupTask
      are unaffected). A non-uiAccess launcher-stub Application would restore that
      button but drags AUMID/startupTask identity through an extra hop — deliberately
      not done.
    - Logos are PNG (MSIX does not use .ico for tiles/Start/taskbar). The manifest
      names the base logos; Windows resolves the scale-*/targetsize-*/altform-unplated
      variants via resources.pri (generated by makepri at pack time).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  IgnorableNamespaces="uap uap5 rescap desktop6">

  <Identity
    Name="@IDENTITY_NAME@"
    Publisher="@PUBLISHER@"
    Version="@VERSION@"
    ProcessorArchitecture="@ARCH@" />

  <Properties>
    <DisplayName>Clipp</DisplayName>
    <PublisherDisplayName>@PUBLISHER_DISPLAY_NAME@</PublisherDisplayName>
    <Logo>Images\StoreLogo.png</Logo>
    <!-- File writes land in the REAL file system, not the per-package overlay.
         Needed by the Explorer SendTo integration: the Clipp.lnk must land in the
         real shell:SendTo folder (under %APPDATA%) or Explorer never shows it -- the
         file-side twin of the copy-on-write registry trap above. Pairs with the
         unvirtualizedResources capability below. Consequences: (a) app state files
         (%LOCALAPPDATA%\Clipp: register snapshot, logs, crashdumps) now land in the
         real location, shared with an unpackaged install and left behind on
         uninstall -- settings/key/host id are REGISTRY and stay virtualized, and a
         once-virtualized register snapshot is re-synced from the mesh, so no file
         migration is needed on upgrade; (b) desktop6 is ignorable, so pre-2004
         Windows keeps virtualization on and SendTo registration is silently inert
         there. -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="uiAccess" />
    <!-- Gates desktop6:FileSystemWriteVirtualization above. RESTRICTED capability:
         sideload/winget of a signed package is fine; a Store submission needs
         Partner Center approval (justification: the SendTo shortcut must be written
         to the user's real shell:SendTo folder to appear in Explorer). -->
    <rescap:Capability Name="unvirtualizedResources" />
    <Capability Name="privateNetworkClientServer" />
    <Capability Name="internetClientServer" />
  </Capabilities>

  <Applications>
    <Application Id="Clipp" Executable="clippmain.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Clipp"
        Description="Share your clipboard across your trusted devices on the local network."
        BackgroundColor="#2D2D30"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png">
        <uap:DefaultTile Square71x71Logo="Images\Square71x71Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="clippmain.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="ClippAutoStart" Enabled="false" DisplayName="Clipp" />
        </uap5:Extension>
        <!-- NOT a command-line entry point (`clipp` on PATH is the CLI twin's alias
             below) — this exists as the VERSION-STABLE target for the SendTo shortcut
             (SendTo.cpp): the real WindowsApps\<name>_<version>_...\clippmain.exe path
             dies on every package update, while the alias under
             %LOCALAPPDATA%\Microsoft\WindowsApps survives them, forwards the appended
             file arguments, and launches with package identity. -->
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="clippgui.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>

    <Application Id="ClippCli" Executable="clipp.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        AppListEntry="none"
        DisplayName="Clipp (CLI)"
        Description="Clipp command-line interface."
        BackgroundColor="#2D2D30"
        Square150x150Logo="Images\Square150x150Logo.png"
        Square44x44Logo="Images\Square44x44Logo.png" />
      <Extensions>
        <uap5:Extension Category="windows.appExecutionAlias">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="clipp.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
